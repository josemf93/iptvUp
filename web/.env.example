NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

FIREBASE_PROJECT_ID=REPLACE_ME

# Opción local: ruta al JSON de la cuenta de servicio (fuera del repositorio).
# GOOGLE_APPLICATION_CREDENTIALS="C:\ruta\serviceAccount.json"

# Opción para Vercel / producción:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@REPLACE_ME.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# 32 bytes en base64. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=REPLACE_ME
