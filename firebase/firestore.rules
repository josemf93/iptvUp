rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{uid} {
      // Las cuentas solo las crea el panel con el Admin SDK.
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
      allow delete: if isAdmin();

      match /iptvProfiles/{profileId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /favorites/{documentId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }

        match /hidden/{documentId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
    }
  }
}
